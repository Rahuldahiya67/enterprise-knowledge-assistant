# Copy to .env and fill in. Everything works with the defaults (offline mode, no keys).

# --- Providers: offline | openai | anthropic -----------------------------------
EKA_LLM_PROVIDER=offline
EKA_EMBEDDING_PROVIDER=offline          # offline | openai

EKA_OPENAI_API_KEY=
EKA_ANTHROPIC_API_KEY=
EKA_OPENAI_CHAT_MODEL=gpt-4o-mini
EKA_ANTHROPIC_MODEL=claude-sonnet-4-5
EKA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store: memory | mongo ----------------------------------------------
EKA_VECTOR_STORE=memory
EKA_INDEX_PATH=data/index
# MongoDB Atlas (cloud) or the local Atlas image from docker-compose:
# EKA_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# EKA_MONGO_URI=mongodb://localhost:27017/?directConnection=true
EKA_MONGO_DB=eka
EKA_MONGO_COLLECTION=chunks

# --- Retrieval -----------------------------------------------------------------
EKA_CHUNK_SIZE=700
EKA_CHUNK_OVERLAP=120
EKA_TOP_K=5
EKA_CANDIDATE_K=20
EKA_RERANKER=lexical                   # lexical | cross-encoder (pip install sentence-transformers)
EKA_MIN_RELEVANCE=0.30

# --- API -----------------------------------------------------------------------
# If set, every request except /health must send header X-API-Key
EKA_API_KEY=
